{
  "name": "impeller",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A web shop for a parametric part, built on one OFB file: a pump impeller configured live on its ClassCAD model (impeller.ofb), running in the browser with buerli.io",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && firebase deploy --only hosting:production",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"cad/**/*.js\""
  },
  "dependencies": {
    "@buerli.io/classcad": "1.2.0",
    "@buerli.io/react": "1.2.0",
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "three-stdlib": "^2.34.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "3.9.9",
    "vite": "^5.4.11"
  }
}
